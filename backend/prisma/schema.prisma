generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  roles        String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  soilTestCenter   SoilTestCenter?
  soilTestRequests SoilTestRequest[]
  products         Product[]
  machinery        Machinery[]
}

// Minimal models for now, we will add more for other modules later.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  channel   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  userId    String
  timestamp DateTime @default(now())
}

model SoilTestCenter {
  id        String   @id @default(uuid())
  name      String
  location  String
  agentId   String   @unique
  agent     User     @relation(fields: [agentId], references: [id])
  requests  SoilTestRequest[]
  createdAt DateTime @default(now())
}

model SoilTestRequest {
  id        String   @id @default(uuid())
  farmerId  String
  farmer    User     @relation(fields: [farmerId], references: [id])
  centerId  String
  center    SoilTestCenter @relation(fields: [centerId], references: [id])
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String   @id @default(uuid())
  vendorId      String
  vendor        User     @relation(fields: [vendorId], references: [id])
  title         String
  category      String   // FERTILIZER, SEED, PESTICIDE, TOOL, BIO_ORGANIC, OTHER
  brand         String?
  description   String?
  price         Float
  unit          String   // e.g. "50kg Bag", "1kg Packet", "Liter", "Piece"
  stockQuantity Int      @default(0)
  safetyWarning String?  // Specific warning/safety instructions (BR-MK-02, REQ-MK-10)
  imageUrl      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Machinery {
  id                String   @id @default(uuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  name              String
  type              String   // Tractor, Harvester, Power Tiller, Rotavator, Sprayer, Seed Drill, Other
  dailyRate         Float    // Rental rate per day (minimum 1 day / 8 hours per BR-EQ-01)
  securityDeposit   Float    @default(0) // Security deposit terms (BR-EQ-02)
  location          String
  operationalStatus String   @default("AVAILABLE") // AVAILABLE, UNDER_MAINTENANCE, RENTED
  instantApproval   Boolean  @default(false) // REQ-EQ-01, REQ-EQ-10
  specifications    String?  // Horsepower, model year, fuel policy, driver included
  imageUrl          String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

