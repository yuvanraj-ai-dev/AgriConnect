generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  roles        String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Minimal models for now, we will add more for other modules later.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  channel   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  userId    String
  timestamp DateTime @default(now())
}

model SoilTestCenter {
  id        String   @id @default(uuid())
  name      String
  location  String
  agentId   String
  agent     User     @relation(fields: [agentId], references: [id])
  requests  SoilTestRequest[]
  createdAt DateTime @default(now())
}

model SoilTestRequest {
  id        String   @id @default(uuid())
  farmerId  String
  farmer    User     @relation(fields: [farmerId], references: [id])
  centerId  String
  center    SoilTestCenter @relation(fields: [centerId], references: [id])
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
