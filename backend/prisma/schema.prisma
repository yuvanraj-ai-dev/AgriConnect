generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  roles        String   // JSON stringified array for SQLite
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Minimal models for now, we will add more for other modules later.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  channel   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  userId    String
  timestamp DateTime @default(now())
}
